{
  "id": "gen5w-digital-control",
  "name": "Digital Control+",
  "version": "1.0.0",
  "hmgapi": ">=1.0.2",
  "authors": ["DigitalControlPlus"],
  "license": "MIT",
  "description": "Digital Control+: Bluetooth & optional self-hosted E2EE Wi-Fi phone companion car control, Bluelink remote climate, EV preconditioning & charging monitor, and AC Profiles for Gen5W head units.",
  "system": {
    "android": "4.4.2"
  },
  "apps": [
    {
      "apk": "app/Gen5WDigitalControl.apk",
      "package": "com.gen5w.digitalcontrol"
    }
  ],
  "services": [
    {
      "name": "digital-control-svc",
      "jar": "svc/digital-control-svc.jar",
      "class": "com.gen5w.digitalcontrol.svc.ControlDaemon",
      "user": "root",
      "start": "android",
      "restart": true
    }
  ],
  "exports": {
    "queries": [],
    "commands": []
  }
}
